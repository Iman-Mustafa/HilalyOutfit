# =====================================================================
# HILALY OUTFIT - USANIDI WA SERVER (nakili faili hili kuwa `.env`)
# USIWEKE `.env` KWENYE GIT. Faili hili ni mfano tu, halina siri halisi.
# =====================================================================

# --- SERVER -----------------------------------------------------------
# Port ambayo API itasikiliza.
PORT=5000
# development | production
NODE_ENV=development

# --- DATABASE (MongoDB) -----------------------------------------------
# Kiungo cha MongoDB. Mifano:
#   MongoDB Atlas : mongodb+srv://USER:PASS@cluster.mongodb.net/hilaly
#   Local         : mongodb://127.0.0.1:27017/hilaly
# Ikiachwa tupu kwenye development, server itawasha database ya majaribio
# (mongodb-memory-server) inayohifadhi data kwenye server/.data/db.
# Kwenye production LAZIMA ijazwe, la sivyo server haitawaka.
MONGODB_URI=

# --- AUTH (JWT) -------------------------------------------------------
# Siri ya kusaini token. Tengeneza kwa:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Kwenye production lazima iwe na angalau herufi 32, la sivyo server haitawaka.
JWT_SECRET=
# Muda wa token kuisha (mf. 7d, 12h).
JWT_EXPIRES_IN=7d

# --- CORS -------------------------------------------------------------
# Anwani za frontend zinazoruhusiwa, zitenganishe kwa koma.
CLIENT_ORIGIN=http://localhost:5173

# --- ADMIN WA KWANZA --------------------------------------------------
# Akaunti ya admin hutengenezwa kiotomatiki server inapowaka (kama haipo).
# Kama mtumiaji mwenye namba hii yupo tayari, hupandishwa kuwa admin.
ADMIN_NAME=Hilaly Admin
ADMIN_PHONE=0700000001
# Angalau herufi 8, iwe na herufi na tarakimu. Ikiachwa tupu admin hatengenezwi.
ADMIN_PASSWORD=

# --- CLOUDINARY (picha za bidhaa) -------------------------------------
# Pata hizi kwenye https://console.cloudinary.com (Dashboard > API Keys).
# Zikiachwa tupu, admin bado anaweza kuongeza bidhaa kwa kiungo cha picha (imageUrl).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folda ya Cloudinary ambamo picha zitahifadhiwa.
CLOUDINARY_FOLDER=hilaly-outfit/products

# --- MALIPO -----------------------------------------------------------
# simulator = malipo ya majaribio (hakuna pesa halisi inayotumwa).
# gateway   = imehifadhiwa kwa ajili ya aggregator halisi (bado haijaunganishwa).
PAYMENT_DRIVER=simulator
# Siri ambayo gateway itatuma kwenye header `x-webhook-secret` ya POST /api/payments/webhook.
PAYMENT_WEBHOOK_SECRET=

# Mfano wa vigezo vya gateway halisi (vitatumika PAYMENT_DRIVER=gateway itakapounganishwa
# ndani ya src/services/payments/gateway.js). Kwa sasa HAVITUMIKI:
# GATEWAY_API_URL=https://api.mfano-gateway.co.tz/v1/checkout/stk-push
# GATEWAY_PUBLIC_KEY=pub_xxxxxxxxxxxxxxxxxxxx
# GATEWAY_SECRET_KEY=sec_xxxxxxxxxxxxxxxxxxxx
# GATEWAY_CALLBACK_URL=https://hilalyoutfit.co.tz/api/payments/webhook
